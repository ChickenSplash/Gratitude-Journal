# Local development only. The Docker image carries its own defaults and
# generates an APP_KEY on first boot, so nothing here is needed to run the
# container — see the README.
#
# Careful: Docker Compose also reads this file, for ${...} interpolation in
# docker-compose.yml. Adding a variable named after something Compose
# interpolates will change what the container is started with.

APP_NAME="Gratitude Journal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Relative paths resolve against database/. The container overrides this with
# /data/journal.sqlite, which is bind-mounted back out to ./data.
DB_CONNECTION=sqlite
# DB_DATABASE=/data/journal.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Leave unset to let the session cookie mark itself Secure whenever the request
# arrived over HTTPS — which it does behind the tunnel, and doesn't on
# http://localhost. Force it either way only if you have a reason to.
# SESSION_SECURE_COOKIE=true

# Nothing sends mail yet. Filling this in is step three of turning on email
# verification — see "Email verification" in the README.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="journal@example.com"
MAIL_FROM_NAME="${APP_NAME}"
